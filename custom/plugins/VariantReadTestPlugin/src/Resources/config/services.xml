<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="VariantReadTestPlugin\Command\ExampleCommand">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <tag name="console.command"/>
        </service>

        <service id="VariantReadTestPlugin\ScheduledTask\ExampleTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="VariantReadTestPlugin\Subscriber\MySubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="VariantReadTestPlugin\Storefront\Controller\ExampleController" public="true">
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <call method="setTwig">
                 <argument type="service" id="twig"/>
             </call>
        </service>

        <service id="VariantReadTestPlugin\Core\Content\Example\SalesChannel\ExampleRoute">
            <argument type="service" id="product.repository"/>
        </service>

        <service id="VariantReadTestPlugin\Core\Content\TestObject1\TestObject1Definition">
            <tag name="shopware.entity.definition" entity="test_object1" />
        </service>

        <service id="VariantReadTestPlugin\Core\Content\TestObject2\TestObject2Definition">
            <tag name="shopware.entity.definition" entity="test_object2" />
        </service>

        <service id="VariantReadTestPlugin\Service\CustomFieldsInstaller">
            <argument type="service" id="custom_field_set.repository"/>
            <argument type="service" id="custom_field_set_relation.repository"/>
        </service>

    </services>
</container>